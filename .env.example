# GEO-SaaS 环境变量模板
# 用法：复制为 .env 并填入真实值（.env 已在 .gitignore 中，不会入库）
#   cp .env.example .env

# ---------- 必填（生产环境缺失会导致启动失败）----------

# JWT 签名密钥，Base64 编码、解码后至少 32 字节
# 生成：openssl rand -base64 32
JWT_SECRET=

# 允许跨域访问的前端域名，多个用英文逗号分隔。禁止填 *
CORS_ALLOWED_ORIGINS=http://localhost

# ---------- 默认口令守卫 ----------
# init.sql 内置的管理员默认口令散列公开存在于仓库，等同凭据泄露。
# prod 档案（docker-compose 默认）检测到仍是默认口令会直接拒绝启动，
# 请先按 README「首次部署」改密。确认要临时沿用默认值时才放开下面这行（自行承担风险）：
#   DEFAULT_PASSWORD_ACTION=disabled   # 放行 + 告警；或 warn = 仅告警
# 留空（不设置）时各档案使用自身默认值：prod=fail（拒绝启动），dev=warn（仅告警）。

# ---------- 数据库 ----------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=geo_saa
MYSQL_USER=root
# 开发默认值：仅供本地起服务用，与下方 README「开发模式」一节保持一致。
# 生产部署前必须改成强口令——docker-compose.yml 用的是 ${MYSQL_PASSWORD} 无默认值语法，
# 这里给的值只是让 `cp .env.example .env` 之后能直接起来，不会掩盖配置缺失。
MYSQL_PASSWORD=root

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ---------- RabbitMQ ----------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ---------- 应用 ----------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ---------- Docker Compose 端口映射 ----------
# 以下变量由 docker-compose.yml 消费。docker 部署时容器内部一律走服务名
# （backend 读 mysql:3306 / redis:6379 / rabbitmq:5672），这里的值只决定宿主机侧映射。
# 与上面 MYSQL_PORT / REDIS_PORT / SERVER_PORT 的区别：那些是「应用连谁」，
# 这些是「宿主机暴露到哪个端口」。
BACKEND_PORT=8080
FRONTEND_PORT=80

# ---------- 时区 ----------
# 影响容器内 JVM 的默认时区，进而影响定时任务（GEO 采集器每日 01:30）的触发时刻。
TZ=Asia/Shanghai

# ---------- 备份保留策略 ----------
# 仅 backup 一次性容器使用：
#   docker compose --profile ops run --rm backup
# 清理 /backups 下超过该天数的 geo_saa-*.sql.gz
BACKUP_RETENTION_DAYS=14
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# ---------- AI 服务 ----------
# 留空且 AI_SIMULATION_ENABLED=true 时使用内置模拟数据，无需真实 Key
AI_SIMULATION_ENABLED=true
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4
TONGYI_API_KEY=
DOUBAO_API_KEY=
# AI 调用超时（毫秒）
AI_CONNECT_TIMEOUT=5000
AI_READ_TIMEOUT=60000

# ---------- GEO 真实数据采集器（G-01，默认关闭）----------
# 启用后每日 01:30 定时从 AI 搜索源采集真实 mentionRate 等指标写入 data_monitor_stat。
# 至少启用一个引擎并填入 API Key；任何引擎失败只记日志不写库，绝不写入模拟数据。
GEO_COLLECTOR_ENABLED=false
GEO_COLLECTOR_BRANDS=
GEO_COLLECTOR_PROBES=3
GEO_COLLECTOR_TIMEOUT=20
# Perplexity 官方 API（https://docs.perplexity.ai）
GEO_PERPLEXITY_ENABLED=false
GEO_PERPLEXITY_API_KEY=
GEO_PERPLEXITY_API_URL=https://api.perplexity.ai/chat/completions
GEO_PERPLEXITY_MODEL=sonar
# OpenAI 兼容网关（通义/豆包/DeepSeek 等）
GEO_OPENAI_COMPAT_ENABLED=false
GEO_OPENAI_COMPAT_API_KEY=
GEO_OPENAI_COMPAT_API_URL=
GEO_OPENAI_COMPAT_MODEL=
