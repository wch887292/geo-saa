# =========================================
# GEO-SaaS 平台环境变量配置示例
# 复制此文件为 .env 并根据需要修改
# =========================================

# -- 数据库配置 --
# MySQL 用户名，默认 root
MYSQL_USER=root
# MySQL 密码，默认 root
MYSQL_PASSWORD=root

# -- RabbitMQ 配置 --
# RabbitMQ 用户名，默认 guest
RABBITMQ_USER=guest
# RabbitMQ 密码，默认 guest
RABBITMQ_PASS=guest

# -- AI 模型配置（可选）--
# 如不配置，部分 AI 功能将不可用
# OpenAI API Key
OPENAI_API_KEY=
# 通义千问 API Key
TONGYI_API_KEY=
# 豆包 API Key
DOUBAO_API_KEY=

# -- 部署模式 --
# 是否启用私有化部署模式（true/false）
PRIVATE_MODE=false