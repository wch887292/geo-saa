# ============================================================
# GEO-SaaS 私有化部署环境变量模板
# 复制为 .env 并修改实际值：cp .env.example .env
# ============================================================

# ---------- 基础配置 ----------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# ---------- 数据库（MySQL 默认）----------
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=geo_saa
MYSQL_USER=root
MYSQL_PASSWORD=your_strong_password

# 信创数据库（二选一，使用时注释上面的 MySQL 配置）
# 达梦 DM:
# SPRING_DATASOURCE_URL=jdbc:dm://dm-host:5236/geo_saa
# SPRING_DATASOURCE_USERNAME=SYSDBA
# SPRING_DATASOURCE_PASSWORD=your_dm_password
# SPRING_DATASOURCE_DRIVER_CLASS_NAME=dm.jdbc.driver.DmDriver

# 人大金仓 KingbaseES:
# SPRING_DATASOURCE_URL=jdbc:kingbase8://kingbase-host:54321/geo_saa
# SPRING_DATASOURCE_USERNAME=system
# SPRING_DATASOURCE_PASSWORD=your_kingbase_password
# SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.kingbase8.Driver

# 数据库连接池
DB_MAX_POOL_SIZE=20
DB_MIN_IDLE=5

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ---------- RabbitMQ（可选，默认关闭）----------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_ENABLED=false

# ---------- JWT（必须修改）----------
# 生成命令：openssl rand -base64 32
JWT_SECRET=please_change_this_to_a_random_base64_string_at_least_32_chars
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# ---------- CORS ----------
CORS_ALLOWED_ORIGINS=http://localhost,http://your-domain.com

# ---------- AI 配置 ----------
OPENAI_API_KEY=sk-your-openai-key
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4
TONGYI_API_KEY=
DOUBAO_API_KEY=
AI_SIMULATION_ENABLED=false

# ---------- RAG 配置 ----------
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_DIMENSIONS=1536
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_DEFAULT_TOP_K=5
RAG_DEFAULT_MIN_SIMILARITY=0.3

# ---------- GEO 数据采集（默认关闭）----------
GEO_COLLECTOR_ENABLED=false

# ---------- 日志级别 ----------
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_GEOSAA=INFO
LOG_LEVEL_SPRING=WARN
