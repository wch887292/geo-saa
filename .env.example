# GEO-SaaS 环境变量模板
# 用法：复制为 .env 并填入真实值（.env 已在 .gitignore 中，不会入库）
#   cp .env.example .env

# ---------- 必填（生产环境缺失会导致启动失败）----------

# JWT 签名密钥，Base64 编码、解码后至少 32 字节
# 生成：openssl rand -base64 32
JWT_SECRET=

# 允许跨域访问的前端域名，多个用英文逗号分隔。禁止填 *
CORS_ALLOWED_ORIGINS=http://localhost

# ---------- 数据库 ----------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=geo_saa
MYSQL_USER=root
MYSQL_PASSWORD=

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ---------- RabbitMQ ----------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ---------- 应用 ----------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# ---------- AI 服务 ----------
# 留空且 AI_SIMULATION_ENABLED=true 时使用内置模拟数据，无需真实 Key
AI_SIMULATION_ENABLED=true
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4
TONGYI_API_KEY=
DOUBAO_API_KEY=
# AI 调用超时（毫秒）
AI_CONNECT_TIMEOUT=5000
AI_READ_TIMEOUT=60000
