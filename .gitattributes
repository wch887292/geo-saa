# 自动识别文本/二进制，统一换行符为 LF（跨平台一致）
* text=auto eol=lf

# 源码统一 LF
*.java      text eol=lf
*.xml       text eol=lf
*.properties text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.js        text eol=lf
*.ts        text eol=lf
*.vue       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.sql       text eol=lf
*.ps1       text eol=lf
*.sh        text eol=lf
*.dockerfile text eol=lf

# 二进制文件
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.jar       binary
*.war       binary
*.zip       binary
