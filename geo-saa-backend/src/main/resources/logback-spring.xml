<?xml version="1.0" encoding="UTF-8"?>
<!--
  日志配置（O3 可观测性）。
  - dev  profile：可读文本格式，方便本地调试
  - prod profile：JSON 结构化日志（logstash-logback-encoder），含 traceId/userId/requestId 等 MDC 字段，
    可直接被 ELK / Loki / 阿里云 SLS 等日志平台采集与检索。
  所有格式统一包含 MDC 中的 traceId，确保单次请求的调用链可串起。
-->
<configuration>
    <springProfile name="dev,local">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} [traceId=%X{traceId:-}] - %msg%n</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <springProfile name="prod">
        <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <!-- 统一字段名，避免与日志平台默认字段冲突 -->
                <fieldNames>
                    <timestamp>@timestamp</timestamp>
                    <version>[ignore]</version>
                    <message>message</message>
                    <logger>logger</logger>
                    <thread>thread</thread>
                    <level>level</level>
                </fieldNames>
                <!-- MDC 中的 traceId/userId/requestId/path/duration_ms 自动作为顶层字段输出 -->
                <includeMdcKeyName>traceId</includeMdcKeyName>
                <includeMdcKeyName>userId</includeMdcKeyName>
                <includeMdcKeyName>requestId</includeMdcKeyName>
                <includeMdcKeyName>path</includeMdcKeyName>
                <includeMdcKeyName>duration_ms</includeMdcKeyName>
                <!-- 堆栈信息也结构化输出 -->
                <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                    <maxDepthPerThrowable>30</maxDepthPerThrowable>
                    <maxLength>2048</maxLength>
                </throwableConverter>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="JSON_CONSOLE"/>
        </root>
    </springProfile>
</configuration>
